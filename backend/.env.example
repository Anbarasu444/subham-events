# Copy to .env (git-ignored) and adjust. Never commit real values.

# local | staging | prod
APP_ENV=local
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Application role (DML only) — see database/README.md
DATABASE_URL=postgres://app_rw:change-me@localhost:5432/event_planner_dev
# Migrator role (DDL) — used only by `npm run migration:*`
DATABASE_MIGRATION_URL=postgres://migrator:change-me@localhost:5432/event_planner_dev

# Firebase project that issues the app's ID tokens (staging project for local development)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to the Firebase service-account JSON — keep the file OUTSIDE the repository
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/firebase-admin.json
# Optional: in-process scheduled jobs (event auto-complete, idempotency-key clean-up). Default true.
BACKGROUND_JOBS_ENABLED=true
