# ============================================================
# Event Planning Platform — root .gitignore (monorepo)
# Per-project .gitignore files in user_app/, vendor_app/,
# admin_cms/ and backend/ remain in force and add to these rules.
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editors / IDEs ----------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ---------- Secrets & environment (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
!debug.keystore
key.properties
**/service-account*.json
**/*serviceAccount*.json
**/*-firebase-adminsdk-*.json

# Firebase client config files (google-services.json, GoogleService-Info.plist,
# firebase_options*.dart) are public identifiers and ARE committed
# (user decision 2026-10-06, ADR-0012). Service-account keys are not.

# ---------- Claude Code (local only) ----------
.claude/settings.local.json
.claude/**/*.local.*

# ---------- Node / Next.js / NestJS ----------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
.turbo/

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
**/android/local.properties
**/android/.gradle/
**/android/captures/
**/android/app/debug
**/android/app/profile
**/android/app/release
*.g.dart.incremental
objectbox-model.json.bak

# ---------- Logs / misc ----------
*.log
logs/
tmp/
*.tmp
