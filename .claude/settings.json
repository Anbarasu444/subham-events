{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter --version)",
      "Bash(flutter doctor:*)",
      "Bash(dart format --output=none:*)",
      "Bash(dart analyze:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git init:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(psql:*)",
      "Bash(firebase:*)",
      "Bash(flutterfire:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/service-account*.json)",
      "Read(**/*serviceAccount*.json)",
      "Read(**/*-firebase-adminsdk-*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(flutter create:*)",
      "Bash(npx create-next-app:*)",
      "Bash(nest new:*)",
      "Bash(npx @nestjs/cli new:*)",
      "Bash(npm publish:*)",
      "Bash(dropdb:*)"
    ]
  }
}
